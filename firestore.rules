rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - photoURL: string (optional)
    //   - generationsUsed: number (optional)
    //   - lastGenerationDate: string (optional)
    //
    // Collection: stories
    // Document ID: {storyId}
    // Fields:
    //   - userId: string (required)
    //   - title: string (required)
    //   - fandom: string (required)
    //   - content: string (required)
    //   - date: string (optional)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 200 &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() < 1000)) &&
             (!('generationsUsed' in data) || (data.generationsUsed is number && data.generationsUsed >= 0)) &&
             (!('lastGenerationDate' in data) || (data.lastGenerationDate is string && data.lastGenerationDate.size() < 50));
    }

    function isValidStory(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             data.fandom is string && data.fandom.size() > 0 && data.fandom.size() < 500 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 100000 &&
             (!('date' in data) || (data.date is string && data.date.size() < 100)) &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasRequiredFields(['uid', 'email']) && isValidUser(request.resource.data) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /stories/{storyId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && hasRequiredFields(['userId', 'title', 'fandom', 'content', 'createdAt']) && isValidStory(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isDocOwner() && isValidStory(request.resource.data) && request.resource.data.userId == resource.data.userId && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isDocOwner();
    }
  }
}
